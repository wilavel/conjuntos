# Variables de Docker Compose para Trend. Copia este archivo como ".env" (en esta misma carpeta).
# La configuración de la aplicación (correo, super admin, edificio…) sigue en backend/.env

# Contraseña del PostgreSQL del contenedor (inventa una larga)
DB_PASSWORD=cambia-esta-contrasena

# Puerto local para entrar desde este PC: http://localhost:8080
TREND_PUERTO=8080
